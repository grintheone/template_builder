{
  "name": "@studio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "demo:fixture": "tsx src/testing/create-demo.ts",
    "smoke:analysis": "tsx src/testing/smoke-analysis.ts",
    "smoke:workflow": "tsx src/testing/smoke-workflow.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@studio/shared": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^12.4.1",
    "docxtemplater": "^3.71.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ollama": "^0.6.4",
    "pizzip": "^3.3.0",
    "yauzl": "^3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/yauzl": "^2.10.3",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5"
  }
}
